leNo":"1201"},{"id":"Rowan-1034","county":"Rowan","cyid":"85","fileNo":"1034"},{"id":"Iredell-0015","county":"Iredell","cyid":"54","fileNo":"15"},{"id":"Rowan-2527","county":"Rowan","cyid":"85","fileNo":"2527"},{"id":"Rowan-1472","county":"Rowan","cyid":"85","fileNo":"1472"},{"id":"Rowan-1532","county":"Rowan","cyid":"85","fileNo":"1532"},{"id":"Rowan-0916","county":"Rowan","cyid":"85","fileNo":"916"},{"id":"Rowan-2296","county":"Rowan","cyid":"85","fileNo":"2296"},{"id":"Rowan-1860","county":"Rowan","cyid":"85","fileNo":"1860"},{"id":"Rowan-1951","county":"Rowan","cyid":"85","fileNo":"1951"},{"id":"Rowan-1805","county":"Rowan","cyid":"85","fileNo":"1805"},{"id":"Rowan-2202","county":"Rowan","cyid":"85","fileNo":"2202"},{"id":"Rowan-0480","county":"Rowan","cyid":"85","fileNo":"480"},{"id":"Rowan-0469","county":"Rowan","cyid":"85","fileNo":"469"},{"id":"Rowan-0915","county":"Rowan","cyid":"85","fileNo":"915"},{"id":"Iredell-0163","county":"Iredell","cyid":"54","fileNo":"163"},{"id":"Iredell-0164","county":"Iredell","cyid":"54","fileNo":"164"},{"id":"Rowan-1762","county":"Rowan","cyid":"85","fileNo":"1762"},{"id":"Rowan-1959","county":"Rowan","cyid":"85","fileNo":"1959"},{"id":"Rowan-1192","county":"Rowan","cyid":"85","fileNo":"1192"},{"id":"Rowan-1586","county":"Rowan","cyid":"85","fileNo":"1586"},{"id":"Rowan-1759","county":"Rowan","cyid":"85","fileNo":"1759"},{"id":"Rowan-2515","county":"Rowan","cyid":"85","fileNo":"2515"},{"id":"Rowan-0511","county":"Rowan","cyid":"85","fileNo":"511"},{"id":"Rowan-1778","county":"Rowan","cyid":"85","fileNo":"1778"},{"id":"Rowan-2310","county":"Rowan","cyid":"85","fileNo":"2310"},{"id":"Rowan-2346","county":"Rowan","cyid":"85","fileNo":"2346"},{"id":"Rowan-2261","county":"Rowan","cyid":"85","fileNo":"2261"},{"id":"Rowan-2129","county":"Rowan","cyid":"85","fileNo":"2129"},{"id":"Rowan-1807","county":"Rowan","cyid":"85","fileNo":"1807"},{"id":"Rowan-1061","county":"Rowan","cyid":"85","fileNo":"1061"},{"id":"Rowan-1072","county":"Rowan","cyid":"85","fileNo":"1072"},{"id":"Rowan-1075","county":"Rowan","cyid":"85","fileNo":"1075"},{"id":"Rowan-0879","county":"Rowan","cyid":"85","fileNo":"879"},{"id":"Rowan-1123","county":"Rowan","cyid":"85","fileNo":"1123"},{"id":"Rowan-1564","county":"Rowan","cyid":"85","fileNo":"1564"},{"id":"Rowan-2128","county":"Rowan","cyid":"85","fileNo":"2128"},{"id":"Rowan-2136","county":"Rowan","cyid":"85","fileNo":"2136"},{"id":"Rowan-2268","county":"Rowan","cyid":"85","fileNo":"2268"},{"id":"Rowan-2478","county":"Rowan","cyid":"85","fileNo":"2478"}];
    const DELAY_MS = 2000; // 2 seconds between requests
    const results = {};
    let completed = 0;
    let errors = 0;

    function sleep(ms) { return new Promise(r => setTimeout(r, ms)); }

    function log(msg) {
        console.log('[Scraper] ' + msg);
    }

    // Step 1: Query the search page to find the grant detail link (MARS ID)
    async function queryGrant(entry) {
        const formData = new URLSearchParams();
        formData.append('pg', 'query');
        formData.append('name', '');
        formData.append('xn', 'F');
        formData.append('cyid', entry.cyid);
        formData.append('datemin', '');
        formData.append('datemax', '');
        formData.append('search', 'SEARCH');
        formData.append('identtype', 'F');
        formData.append('identvalue', entry.fileNo);
        formData.append('sortfld', 'LNDNAME');
        formData.append('show_C', 'on');
        formData.append('show_L', 'on');
        formData.append('gtP', 'on');
        formData.append('gtC', 'on');
        formData.append('gtG', 'on');
        formData.append('gtS', 'on');
        formData.append('gtU', 'on');
        formData.append('usedate', 'B');
        formData.append('screenvals', '1');
        formData.append('screenwidth', window.screen.width.toString());

        const resp = await fetch('/query/', {
            method: 'POST',
            body: formData,
            credentials: 'include'
        });
        const html = await resp.text();

        // Parse the results HTML to find the grant detail link
        const parser = new DOMParser();
        const doc = parser.parseFromString(html, 'text/html');

        // Look for links to /grant/ pages
        const links = doc.querySelectorAll('a[href*="/grant/"]');
        if (links.length === 0) {
            // Try alternate: look for any link containing 'mars='
            const allLinks = doc.querySelectorAll('a[href*="mars="]');
            if (allLinks.length === 0) {
                return null;
            }
            return allLinks[0].href;
        }

        // Get the first grant link
        let href = links[0].getAttribute('href');
        if (href && !href.startsWith('http')) {
            href = new URL(href, 'https://nclandgrants.com').href;
        }
        return href;
    }

    // Step 2: Fetch the grant detail page and extract data
    async function fetchGrantDetail(url) {
        const resp = await fetch(url, { credentials: 'include' });
        const html = await resp.text();

        const parser = new DOMParser();
        const doc = parser.parseFromString(html, 'text/html');
        const body = doc.body;
        if (!body) return null;

        const data = {};

        // Get all text content for parsing
        const fullText = body.innerText || body.textContent || '';

        // Extract the header info (name, county, acres, dates)
        // The grant page typically has structured sections

        // Parse key sections from the HTML
        // Look for bold labels followed by data
        const allBold = doc.querySelectorAll('b, strong');
        allBold.forEach(b => {
            const label = (b.textContent || '').trim();
            const nextText = getNextText(b);
            if (label && nextText) {
                data[label.replace(/:$/, '')] = nextText.trim();
            }
        });

        // Extract narrative section
        const narrativeMatch = fullText.match(/NARRATIVE:(.*?)(?=From PATENT BOOK|From WARRANT|Other Identifiers|Subjects|$)/si);
        if (narrativeMatch) {
            data.narrative = narrativeMatch[1].trim();
        }

        // Extract Patent Book section
        const patentMatch = fullText.match(/From PATENT BOOK[^:]*:(.*?)(?=From WARRANT|Other Identifiers|Subjects|NARRATIVE|$)/si);
        if (patentMatch) {
            data.patentBook = patentMatch[1].trim();
        }

        // Extract Warrant/Plat section
        const warrantMatch = fullText.match(/From WARRANT\/PLAT[^:]*:(.*?)(?=From PATENT|Other Identifiers|Subjects|NARRATIVE|$)/si);
        if (warrantMatch) {
            data.warrantPlat = warrantMatch[1].trim();
        }

        // Extract Other Identifiers
        const identMatch = fullText.match(/Other Identifiers:(.*?)(?=Subjects|NARRATIVE|From PATENT|From WARRANT|$)/si);
        if (identMatch) {
            data.otherIdentifiers = identMatch[1].trim();
        }

        // Extract Subjects
        const subjectMatch = fullText.match(/Subjects:(.*?)$/si);
        if (subjectMatch) {
            data.subjects = subjectMatch[1].trim();
        }

        // Also try to extract structured table data
        const tables = doc.querySelectorAll('table');
        tables.forEach((table, idx) => {
            const rows = table.querySelectorAll('tr');
            rows.forEach(row => {
                const cells = row.querySelectorAll('td, th');
                if (cells.length >= 2) {
                    const key = (cells[0].textContent || '').trim().replace(/:$/, '');
                    const val = (cells[1].textContent || '').trim();
                    if (key && val && key.length < 50) {
                        if (!data[key]) data[key] = val;
                    }
                }
            });
        });

        // Extract key header fields commonly found on grant pages
        // Name/Grantee
        const nameMatch = fullText.match(/(?:Grantee|Granted to|Name)[:\s]+([^\n]+)/i);
        if (nameMatch && !data.grantee) data.grantee = nameMatch[1].trim();

        // County
        const countyMatch = fullText.match(/County[:\s]+([^\n]+)/i);
        if (countyMatch && !data.county) data.county = countyMatch[1].trim();

        // Acres
        const acresMatch = fullText.match(/(\d+)\s*(?:acres|a\.)/i);
        if (acresMatch && !data.acres) data.acres = acresMatch[1];

        // Dates
        const issuedMatch = fullText.match(/Issued[:\s]+([^\n]+)/i);
        if (issuedMatch && !data.issued) data.issued = issuedMatch[1].trim();

        const enteredMatch = fullText.match(/Entered[:\s]+([^\n]+)/i);
        if (enteredMatch && !data.entered) data.entered = enteredMatch[1].trim();

        // File number
        const fileMatch = fullText.match(/File(?:\s*No\.?)?[:\s]+([^\n]+)/i);
        if (fileMatch && !data.fileNo) data.fileNo = fileMatch[1].trim();

        // Grant number
        const grantNoMatch = fullText.match(/Grant(?:\s*No\.?)?[:\s]+([^\n]+)/i);
        if (grantNoMatch && !data.grantNo) data.grantNo = grantNoMatch[1].trim();

        // Location/watercourse
        const locationMatch = fullText.match(/(?:Location|Watercourse|Waters?)[:\s]+([^\n]+)/i);
        if (locationMatch && !data.location) data.location = locationMatch[1].trim();

        // MARS ID from URL
        const marsMatch = url.match(/mars=([^&]+)/);
        if (marsMatch) data.marsId = marsMatch[1];

        // Store full text as fallback
        data._fullText = fullText.substring(0, 5000);
        data._sourceUrl = url;

        return data;
    }

    function getNextText(element) {
        let node = element.nextSibling;
        let text = '';
        while (node && node.nodeType !== 1) {
            if (node.nodeType === 3) text += node.textContent;
            node = node.nextSibling;
        }
        if (!text.trim() && element.parentElement) {
            // Try getting rest of parent text
            const parentText = element.parentElement.textContent || '';
            const labelText = element.textContent || '';
            const idx = parentText.indexOf(labelText);
            if (idx >= 0) {
                text = parentText.substring(idx + labelText.length);
            }
        }
        return text.trim().substring(0, 500);
    }

    // Main loop
    log('Starting NC Land Grants scraper...');
    log('Total grants to query: ' + GRANT_IDS.length);
    log('Estimated time: ~' + Math.ceil(GRANT_IDS.length * DELAY_MS / 60000) + ' minutes');
    log('---');

    for (let i = 0; i < GRANT_IDS.length; i++) {
        const entry = GRANT_IDS[i];
        log('[' + (i+1) + '/' + GRANT_IDS.length + '] Querying ' + entry.id + ' (' + entry.county + ' File #' + entry.fileNo + ')...');

        try {
            // Step 1: Search for the grant
            const grantUrl = await queryGrant(entry);

            if (!grantUrl) {
                log('  WARNING: No results found for ' + entry.id);
                results[entry.id] = { error: 'No results found', county: entry.county, fileNo: entry.fileNo };
                errors++;
            } else {
                log('  Found grant page: ' + grantUrl);

                // Step 2: Fetch detail page
                await sleep(500); // small delay between search and detail
                const detail = await fetchGrantDetail(grantUrl);

                if (detail) {
                    detail.mblId = entry.id;
                    detail.searchCounty = entry.county;
                    detail.searchFileNo = entry.fileNo;
                    results[entry.id] = detail;
                    log('  SUCCESS: Got data for ' + entry.id);
                } else {
                    results[entry.id] = { error: 'Could not parse grant page', url: grantUrl, county: entry.county, fileNo: entry.fileNo };
                    errors++;
                    log('  WARNING: Could not parse grant page for ' + entry.id);
                }
            }
        } catch (err) {
            log('  ERROR: ' + err.message);
            results[entry.id] = { error: err.message, county: entry.county, fileNo: entry.fileNo };
            errors++;
        }

        completed++;

        // Progress
        const pct = Math.round(completed / GRANT_IDS.length * 100);
        log('  Progress: ' + pct + '% (' + completed + '/' + GRANT_IDS.length + ', ' + errors + ' errors)');

        // Delay between requests
        if (i < GRANT_IDS.length - 1) {
            await sleep(DELAY_MS);
        }
    }

    // Done! Download results
    log('===================================');
    log('COMPLETE! ' + completed + ' grants processed, ' + errors + ' errors.');
    log('Downloading nc_iredell_grants.json...');

    const output = {
        metadata: {
            source: 'nclandgrants.com',
            mblFile: 'NC_Iredell.mbl',
            scrapeDate: new Date().toISOString(),
            totalQueried: GRANT_IDS.length,
            totalSuccess: completed - errors,
            totalErrors: errors
        },
        grants: results
    };

    const blob = new Blob([JSON.stringify(output, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'nc_iredell_grants.json';
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);

    log('Download initiated! Check your Downloads folder.');
    log('You can also access the data via: window._grantResults');
    window._grantResults = output;

    return output;
})();